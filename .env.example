# Server-only. Obtain from Mistral Studio and copy this file to `.env.local`.
MISTRAL_API_KEY=
# Optional. Required before exposing /api/agent/v1 outside localhost.
BOLI_AGENT_API_KEY=
# Keep `demo` for the deterministic signed-webhook flow. Use `razorpay` only with test keys.
BOLI_PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
